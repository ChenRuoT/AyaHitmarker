<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>AyaHitmarker.LogicTests</AssemblyName>
    <RootNamespace>AyaHitmarker.LogicTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <Description>Offline tests for AyaHitmarker's pure logic (streak/achievement engine, kill card model/layout, glitch curves, procedural icon shapes).</Description>
  </PropertyGroup>

  <!--
    这里**只编译纯逻辑源文件**：Game/KillStreak.cs 与 Ui/KillCardLayout.cs 都不引用
    UnityEngine / EFT，所以可以脱离游戏程序集直接跑。
    新增可测文件时把它加到这里，并保持它不引用 Unity/EFT（见 AGENTS.md §2）。
  -->
  <ItemGroup>
    <Compile Include="../../Game/KillStreak.cs" Link="Game/KillStreak.cs" />
    <Compile Include="../../Game/NameKey.cs" Link="Game/NameKey.cs" />
    <Compile Include="../../Game/BodyPartNames.cs" Link="Game/BodyPartNames.cs" />
    <Compile Include="../../Game/DamageAccum.cs" Link="Game/DamageAccum.cs" />
    <Compile Include="../../Game/AssistTracker.cs" Link="Game/AssistTracker.cs" />
    <Compile Include="../../Ui/KillCardLayout.cs" Link="Ui/KillCardLayout.cs" />
    <Compile Include="../../Ui/KillCardModel.cs" Link="Ui/KillCardModel.cs" />
    <Compile Include="../../Ui/UiAnim.cs" Link="Ui/UiAnim.cs" />
    <Compile Include="../../Ui/GlitchMath.cs" Link="Ui/GlitchMath.cs" />
    <Compile Include="../../Ui/HitDirectionMath.cs" Link="Ui/HitDirectionMath.cs" />
    <Compile Include="../../Assets/AudioClipHealth.cs" Link="Assets/AudioClipHealth.cs" />
    <Compile Include="../../Assets/IconShapes.cs" Link="Assets/IconShapes.cs" />
  </ItemGroup>

</Project>
