<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>AyaHitmarker</AssemblyName>
    <RootNamespace>AyaHitmarker</RootNamespace>
    <Product>AyaHitmarker</Product>
    <Description>Hit / kill feedback overlay for SPTushonka (EFT 1.2.0.0 / IL2CPP).</Description>
  </PropertyGroup>

  <!-- ref/ 是 Il2CppDumper 产物所在地，必须从所有默认 Item 类型里剔除。
       尤其是 None：MSBuild 会把 @(None) 传给 ResolveAssemblyReference 的
       CandidateAssemblyFiles，而它在程序集搜索顺序上排在 HintPath 之前，
       会把 interop 的同名程序集全部顶掉（DummyDll 的方法体是空的）。 -->
  <ItemGroup>
    <Compile Remove="ref/**" />
    <None Remove="ref/**" />
    <Content Remove="ref/**" />
    <EmbeddedResource Remove="ref/**" />
    <None Remove="ref/Il2CppDumperOutput/**" />
  </ItemGroup>

  <!-- tests/ 是独立的离线测试工程（自己一份 csproj + 顶层语句 Program.cs）。
       默认 glob 会把 tests/**/*.cs 也收进插件编译，导致重复 Main、引用不存在的
       UnityEngine.UI 等一堆错。和 ref/ 同样处理：整目录从默认 item 里剔除。 -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <Content Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

  <!-- ===== BepInEx 6 运行时（core/），全部 Private=false，不要拷进插件目录 ===== -->
  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(BepInExCore)/BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(BepInExCore)/BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <!-- 本插件零补丁，所以不引用 0Harmony / SPTushonka.Reflection。
         将来真要加补丁时再放开，并先读 AGENTS.md §3.0。 -->
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(BepInExCore)/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- ===== IL2CPP 的 BCL 影子程序集 ===== -->
  <ItemGroup>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(InteropDir)/Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppSystem"><HintPath>$(InteropDir)/Il2CppSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppSystem.Core"><HintPath>$(InteropDir)/Il2CppSystem.Core.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- ===== 游戏程序集（interop 代理） ===== -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(InteropDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(InteropDir)/Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Comfort"><HintPath>$(InteropDir)/Comfort.dll</HintPath><Private>false</Private></Reference>
    <!-- EBodyPart / EBodyPartColliderType / EArmorPlateCollider 等全局枚举在游戏自己的 PlayerEnums 程序集里，
         不在 Assembly-CSharp。不引用它就会报 CS0246。 -->
    <Reference Include="PlayerEnums"><HintPath>$(InteropDir)/PlayerEnums.dll</HintPath><Private>false</Private></Reference>
    <!-- EFT.Player 实现了 IDissonancePlayer，只要碰到 Player 类型就必须能解析这个程序集 -->
    <Reference Include="DissonanceVoip"><HintPath>$(InteropDir)/DissonanceVoip.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- ===== Unity（interop 代理，不是 unity-libs 里的原件） ===== -->
  <ItemGroup>
    <Reference Include="UnityEngine"><HintPath>$(InteropDir)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(InteropDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(InteropDir)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(InteropDir)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(InteropDir)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(InteropDir)/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(InteropDir)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule"><HintPath>$(InteropDir)/UnityEngine.TextCoreFontEngineModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextCoreTextEngineModule"><HintPath>$(InteropDir)/UnityEngine.TextCoreTextEngineModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(InteropDir)/UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(InteropDir)/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <!-- 只给 DebugHarness 的 shot 指令用（ScreenCapture.CaptureScreenshot） -->
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(InteropDir)/UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(InteropDir)/UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule"><HintPath>$(InteropDir)/UnityEngine.UnityWebRequestAudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(InteropDir)/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- 唯一版本来源是 Version.props；生成编译期常量供 BepInPlugin 使用。 -->
  <Target Name="GenerateReleaseVersion" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)ReleaseVersion.g.cs"
      Lines="namespace AyaHitmarker { internal static class ReleaseVersion { internal const string Value = &quot;$(Version)&quot;%3B } }"
      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)ReleaseVersion.g.cs" /></ItemGroup>
  </Target>

  <!-- ===== 生成后自动部署到游戏 =====
       普通构建 → BepInEx/plugins/AyaHitmarker/（正式安装位置）。
       热重载构建（-p:HotReload=true）→ BepInEx/scripts/AyaHitmarker/，供 ScriptEngine.IL2CPP 重载。
       同一个插件不能同时出现在 plugins/ 与 scripts/：引擎看到重名会跳过 scripts 副本，
       热重载就静默失效了。所以两个 target 互相撤回对方的副本。 -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' != 'false' and '$(HotReload)' != 'true'">
    <MakeDir Directories="$(PluginDeployDir)" />
    <!-- 撤回上次热重载模式：备份改名回去由下面的 Copy 覆盖，scripts/ 副本直接删掉 -->
    <Delete Files="$(PluginDeployDir)/$(TargetName).dll.se-disabled;$(PluginDeployDir)/$(TargetName).pdb.se-disabled" />
    <Delete Files="$(HotReloadDeployDir)/$(TargetName).dll;$(HotReloadDeployDir)/$(TargetName).pdb" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDeployDir)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(PluginDeployDir)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Message Importance="high" Text="[AyaHitmarker] deployed -> $(PluginDeployDir)（scripts/ 热重载副本已撤回）" />
  </Target>

  <Target Name="DeployToScripts" AfterTargets="Build" Condition="'$(HotReload)' == 'true' and '$(DeployToGame)' != 'false'">
    <PropertyGroup>
      <!-- 优先照抄当前安装目录的资源（保留本机改过的图标 / 音效），没有就退回仓库 ReleaseAssets/ -->
      <HotReloadAssetSource Condition="Exists('$(PluginDeployDir)/Icons') Or Exists('$(PluginDeployDir)/Sounds')">$(PluginDeployDir)</HotReloadAssetSource>
      <HotReloadAssetSource Condition="'$(HotReloadAssetSource)' == ''">$(MSBuildThisFileDirectory)ReleaseAssets</HotReloadAssetSource>
    </PropertyGroup>
    <ItemGroup>
      <!-- 排除插件 DLL/PDB：它们由下面显式的 Copy（TargetPath）负责，且很可能刚被 Move 走了 -->
      <HotReloadAsset Include="$(HotReloadAssetSource)/**/*"
                      Exclude="$(HotReloadAssetSource)/*.se-disabled;$(HotReloadAssetSource)/$(TargetName).dll;$(HotReloadAssetSource)/$(TargetName).pdb" />
    </ItemGroup>
    <!-- 先禁用 plugins 副本：游戏以普通模式运行时 plugins DLL 被锁，Move 会失败，
         此时还没写 scripts/，构建失败但状态不变（退出游戏再跑一次即可）。
         MSBuild 的 Move 任务没有 Overwrite，先删掉上次留下的备份。 -->
    <Delete Files="$(PluginDeployDir)/$(TargetName).dll.se-disabled;$(PluginDeployDir)/$(TargetName).pdb.se-disabled" />
    <Move SourceFiles="$(PluginDeployDir)/$(TargetName).dll" DestinationFiles="$(PluginDeployDir)/$(TargetName).dll.se-disabled" Condition="Exists('$(PluginDeployDir)/$(TargetName).dll')" />
    <Move SourceFiles="$(PluginDeployDir)/$(TargetName).pdb" DestinationFiles="$(PluginDeployDir)/$(TargetName).pdb.se-disabled" Condition="Exists('$(PluginDeployDir)/$(TargetName).pdb')" />
    <MakeDir Directories="$(HotReloadDeployDir)" />
    <!-- 整个照抄（Icons/、Sounds/ 保留子目录结构），再写本次构建的 DLL/PDB。
         脚本目录里的 DLL 是字节流加载、不锁文件，所以游戏运行时也能反复覆盖。 -->
    <Copy SourceFiles="@(HotReloadAsset)" DestinationFiles="@(HotReloadAsset->'$(HotReloadDeployDir)/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(HotReloadDeployDir)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(HotReloadDeployDir)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Message Importance="high" Text="[AyaHitmarker] hot-reload deploy -> $(HotReloadDeployDir)（plugins/ 副本已禁用）" />
  </Target>

</Project>
