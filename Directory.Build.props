<Project>
  <Import Project="$(MSBuildThisFileDirectory)Version.props" />

  <!-- 本地覆盖（不入库）。要改 GameDir 就复制 Directory.Build.local.props.example。 -->
  <Import Project="Directory.Build.local.props" Condition="Exists('Directory.Build.local.props')" />

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">D:/EFTdev/Client.1.2.0.0.47965</GameDir>
    <BepInExDir>$(GameDir)/BepInEx</BepInExDir>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(BepInExDir)/core</BepInExCore>
    <InteropDir Condition="'$(InteropDir)' == ''">$(BepInExDir)/interop</InteropDir>
    <SptPluginDir>$(BepInExDir)/plugins/sptushonka</SptPluginDir>
    <PluginDeployDir>$(BepInExDir)/plugins/AyaHitmarker</PluginDeployDir>
    <!-- 热重载部署（-p:HotReload=true）：ScriptEngine.IL2CPP 只扫描 scripts/，且要求
         DLL 与 Icons/Sounds 在同一子目录（引擎会把 Assembly.Location 垫成这个目录）。 -->
    <HotReloadDeployDir>$(BepInExDir)/scripts/AyaHitmarker</HotReloadDeployDir>
  </PropertyGroup>

  <PropertyGroup>
    <!-- BepInEx 6 (CoreCLR) 插件必须与运行时同大版本：本机 dotnet/coreclr 为 10.0.12 -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CS0436: 程序集里类型与引用类型同名（IL2CPP 阴影程序集常见） -->
    <NoWarn>$(NoWarn);CS0436;NU1510</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      重要：ref/ 下放着 Il2CppDumper 的产物，其中 DummyDll/ 含有一批和 interop 同名（Assembly-CSharp、
      Comfort、UnityEngine.* …）的「签名桩”程序集。
      它们如果被默认 glob 收成 @(None)，MSBuild 的 ResolveAssemblyReferences 会把 @(None) 当作
      CandidateAssemblyFiles，而 {CandidateAssemblyFiles} 排在 AssemblySearchPaths 首位——
      于是 HintPath 指向的 interop 引用会被这些空方法体的桩顶掉，编译能过但语义全错。
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ref/**;.buildrefs/**;artifacts/**;ReleaseAssets/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
